{
  "name": "framewave",
  "version": "0.1.0",
  "description": "GPU-first, deterministic motion graphics for the web. WebGPU rendering, WebCodecs export, analytic springs, OKLab color — MIT licensed.",
  "author": "Elijah Royaie",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VFitter/framewave.git",
    "directory": "packages/framewave"
  },
  "homepage": "https://vfitter.github.io/framewave/",
  "bugs": {
    "url": "https://github.com/VFitter/framewave/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "motion-graphics", "animation", "video", "webgpu", "webcodecs",
    "remotion-alternative", "deterministic", "spring", "kinetic-typography"
  ],
  "dependencies": {
    "@framewave/core": "0.1.0",
    "@framewave/gpu": "0.1.0",
    "@framewave/export": "0.1.0"
  }
}
