  "files": ["dist"],
  "scripts": {
    "build": "tsc -b"
  },
  "sideEffects": false,
  "dependencies": {
    "@framewave/core": "0.1.0",
    "@framewave/gpu": "0.1.0",
    "mp4-muxer": "^5.1.5",
    "webm-muxer": "^5.0.3"
  }
}
