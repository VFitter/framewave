{
  "name": "@framewave/export",
  "version": "0.1.0",
  "description": "WebCodecs export pipeline for Framewave — hardware-accelerated MP4/WebM encoding straight from the renderer, no headless browser, no FFmpeg.",
  "author": "Elijah Royaie",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "keywords": ["webcodecs", "video", "mp4", "webm", "motion-graphics", "export"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VFitter/framewave.git",
    "directory": "packages/export"
  },
  "homepage": "https://vfitter.github.io/framewave/",
  "bugs": {
    "url": "https://github.com/VFitter/framewave/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@framewave/core": "0.1.0",
    "@framewave/gpu": "0.1.0",
    "mp4-muxer": "^5.1.5",
    "webm-muxer": "^5.0.3"
  }
}
