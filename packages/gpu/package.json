{
  "name": "@framewave/gpu",
  "version": "0.1.0",
  "description": "WebGPU renderer for Framewave scenes — SDF shapes, real motion blur, glow, film grain — with a Canvas2D fallback.",
  "author": "Elijah Royaie",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "keywords": ["webgpu", "canvas", "renderer", "motion-graphics", "animation", "sdf"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VFitter/framewave.git",
    "directory": "packages/gpu"
  },
  "homepage": "https://vfitter.github.io/framewave/",
  "bugs": {
    "url": "https://github.com/VFitter/framewave/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@framewave/core": "0.1.0"
  }
}
