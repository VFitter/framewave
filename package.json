{
  "name": "framewave-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Framewave — a GPU-first, deterministic motion graphics engine for the web. WebGPU rendering, WebCodecs export, analytic animation math.",
  "license": "MIT",
  "author": "Elijah Royaie",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/core packages/gpu packages/export packages/framewave",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:packages": "npm run build && node scripts/verify-package-tarballs.mjs",
    "render:node": "tsx scripts/render-node.mts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.51",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
